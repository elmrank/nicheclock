# Copy to .env (cp .env.example .env). docker compose passes it to the container; never commit it.
# nicheclock.yaml names the variable it reads (api_key_env: ANTHROPIC_API_KEY); the key itself stays here.

# Who you are to the sites nicheclock reads. `init` also reads these two when you omit the flags.
NICHECLOCK_USER_AGENT=
NICHECLOCK_CONTACT_EMAIL=

# Compose: user that owns ./nicheclock-data on the host (run `id -u` and `id -g`), host port of the reports, run interval.
NICHECLOCK_UID=1000
NICHECLOCK_GID=1000
NICHECLOCK_HOST_PORT=8080
NICHECLOCK_INTERVAL_HOURS=24

# Model keys, only for the provider you use (coming with the model layer, see docs/models.md).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional sources and notifications, named in nicheclock.yaml.
GITHUB_TOKEN=
TG_TOKEN=
DISCORD_WEBHOOK=
SMTP_PASSWORD=

# Compose: where the container keeps nicheclock.yaml, data/, out/ and secrets/ (default ./nicheclock-data).
# NICHECLOCK_DIR=./nicheclock-data
